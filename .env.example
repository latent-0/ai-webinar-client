# ─────────────────────────────────────────────────────────────
# Frontend (exposed to the browser — must be prefixed with VITE_)
# Only NON-SECRET values belong here. Anything VITE_-prefixed is inlined
# into the client bundle and readable by anyone. (LLP-129)
# ─────────────────────────────────────────────────────────────
VITE_JITSI_DOMAIN=meet.jit.si

# ─────────────────────────────────────────────────────────────
# Supabase — LLP-74. Powers the live layer (/api/live/*): polls,
# breakouts, presence. Apply supabase/migrations/*.sql to the project.
# ─────────────────────────────────────────────────────────────
# Client (safe to expose — anon key is protected by Row Level Security):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side (SECRET — service role bypasses RLS, NEVER prefix with VITE_):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# AI provider keys — LLP-129 (server-side only, NEVER prefix with VITE_)
# Reached only through the /api/ai/* proxies. Set these in Vercel
# Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────
# Text: Groq is the primary text provider. The model is selected server-side
# (GROQ_MODEL) so the client can't push us past the rate limits.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Public demo mode: allow the /api/ai/* proxies to be used WITHOUT signing in,
# so anyone can join the webinar and use the AI. Off by default (proxies stay
# session-gated). Set to 1 for a public demo/webinar deployment. Because this
# makes the AI an open relay, pair it with a spend/rate cap on the provider key.
ALLOW_PUBLIC_AI=
# Optional text fallbacks (used only if a key is present):
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here

# ─────────────────────────────────────────────────────────────
# Auth backend — LLP-12 (server-side only, NEVER prefix with VITE_)
# Set these in Vercel Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Required to enable auth. A long random string used to sign sessions.
#   Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: restrict who may sign in. Leave both blank to allow any email (dev).
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=napkin.ie

# Email delivery (magic links). Without RESEND_API_KEY the app runs in dev mode
# and returns the link in the response instead of emailing it.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Sandbox <onboarding@resend.dev>

# Durable single-use token store (Vercel KV / Upstash Redis).
# Required for magic links to work reliably in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google SSO + integrations (optional). Create an OAuth 2.0 client in Google
# Cloud Console. The SAME client powers sign-in AND the Calendar/Drive
# integration (Settings → Integrations); the redirect URI is the same
# (/api/auth/google/callback), so nothing extra to register there.
#
# To enable the Calendar + Drive integration, add these READ-ONLY scopes to the
# OAuth consent screen (and, while the app is unverified, add demo accounts as
# Test Users — sensitive scopes are blocked for non-test users until verified):
#   https://www.googleapis.com/auth/calendar.readonly
#   https://www.googleapis.com/auth/drive.metadata.readonly
# Also enable the Google Calendar API and Google Drive API for the project.
# Tokens are sealed (AES-256-GCM via AUTH_SECRET) in an httpOnly cookie — no DB
# needed — so AUTH_SECRET must be set for the integration to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Video backend (optional but REQUIRED for a real webinar). Without these the
# app uses public meet.jit.si, which now requires an authenticated moderator to
# start a meeting (attendees get stuck "waiting for a moderator") and gives no
# private rooms. Configure JaaS (Jitsi as a Service / 8x8 — free tier) so the
# host is a moderator (the meeting starts immediately) and rooms are private
# (only tokens signed by your key can join):
#   1. Create a JaaS app at https://jaas.8x8.vc → get the AppID.
#   2. Add an API key (RSA) → note the Key ID and download the private key.
#   3. Set the three vars below (AUTH_SECRET must also be set — used elsewhere).
# JAAS_PRIVATE_KEY: paste the PEM; on Vercel, newlines can be literal \n.
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=

# Optional: force the base URL used to build magic links (defaults to the
# request host). Useful for staging/custom domains.
PUBLIC_BASE_URL=
